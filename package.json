{
  "name": "shadow-clash",
  "version": "1.0.0",
  "private": true,
  "description": "Shadow Clash - 2D Fighting Game Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@shadow-clash/server",
    "dev:client": "npm run dev --workspace=@shadow-clash/client",
    "dev:admin": "npm run dev --workspace=@shadow-clash/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
